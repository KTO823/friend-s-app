rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 判斷目前登入的人是不是某個群組的成員（會多讀一次 groups 文件來確認）
    function isGroupMember(groupId) {
      return groupId != null
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // --- users：每個人的個人資料（姓名、生日、收款帳號、所屬群組列表等）---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- groups：群組本身（名稱、邀請碼、成員清單）---
    match /groups/{groupId} {
      // 需要能用邀請碼查詢到群組、也需要讀取自己所屬群組的成員名單
      allow read: if isSignedIn();

      // 建立群組：只能把自己設成唯一的初始成員
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid;

      // 三種情況才准許更新：加入群組(把自己加進成員名單)、離開群組(把自己移出)、
      // 或群組擁有者改名稱/頭像(成員名單、擁有者、邀請碼都不能變)
      allow update: if isSignedIn() && (
        (request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.hasAny([request.auth.uid]))
        ||
        (request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && resource.data.memberIds.hasAny([request.auth.uid])
          && !request.resource.data.memberIds.hasAny([request.auth.uid]))
        ||
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.memberIds == resource.data.memberIds)
      );

      allow delete: if false;
    }

    // --- trips：行程（已綁定群組）---
    match /trips/{tripId} {
      allow read: if isSignedIn() && isGroupMember(resource.data.groupId);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isGroupMember(request.resource.data.groupId);
      // 修改/刪除、或把舊資料（沒有 groupId）搬進群組，都只有本人可以動
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // --- gifts：許願池 / 代購委託（已綁定群組）---
    match /gifts/{giftId} {
      allow read: if isSignedIn() && (
        isGroupMember(resource.data.groupId)
        || (resource.data.groupId == null && resource.data.uid == request.auth.uid)
      );
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isGroupMember(request.resource.data.groupId);
      // 一般更新（認領、標記已買）要求同群組；把舊資料搬進群組則只有本人可以動
      allow update: if isSignedIn() && (
        isGroupMember(resource.data.groupId)
        || (resource.data.groupId == null && resource.data.uid == request.auth.uid)
      );
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // --- debts：欠款紀錄（已綁定群組）---
    match /debts/{debtId} {
      allow read: if isSignedIn() && (
        isGroupMember(resource.data.groupId)
        || (resource.data.groupId == null && (resource.data.creditorId == request.auth.uid || resource.data.debtorId == request.auth.uid))
      );
      allow create: if isSignedIn()
        && request.resource.data.creditorId == request.auth.uid
        && request.resource.data.debtorId != request.auth.uid
        && isGroupMember(request.resource.data.groupId);
      // 記帳的人（債主）可以改任何欄位；欠款人只能翻動「確認收到商品」這個欄位
      allow update: if isSignedIn() && (
        resource.data.creditorId == request.auth.uid
        || (resource.data.debtorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['itemReceived']))
      );
      allow delete: if isSignedIn() && resource.data.creditorId == request.auth.uid;
    }
  }
}
